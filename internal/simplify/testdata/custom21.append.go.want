package demo

import (
	"fmt"
	"slices"
)

// 用于测试 custom_append.go

func hello() {
	a := []int{1, 2, 3}

	b1 := slices.Clone(a) // <---- 替换为  slices.Clone(a)
	fmt.Println("b1=", b1)

	a1 := []string{"a", "b", "c"}

	// 下面的会替换为  slices.Clone(a)
	b2 := slices.Clone(a1)
	fmt.Println("b2=", b2)

	c := slices.Clone(a)
	fmt.Println("c=", c)

	fmt.Println("d=", slices.Clone(getStringSlice1())) // 替换为  slices.Clone

	_ = slices.Clone(a)        // <---- 替换为  slices.Clone(a)
	_ = append([]int{1}, a...) // 保持原样
}

func getStringSlice1() []string {
	return []string{"a"}
}
